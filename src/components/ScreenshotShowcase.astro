---
---

<section id="screenshots" class="screenshots-section">
  <div class="container">
    <div class="section-eyebrow" data-i18n="shots_eyebrow">INTERFAZ REAL DE ESCRITORIO</div>
    <h2 class="section-title" data-i18n="shots_title">
      Diseñado para operar rápido en el shack y en remoto
    </h2>
    <p class="section-lead" data-i18n="shots_lead">
      Capturas reales de <strong>NetShack Control</strong> conectado por red a un <strong>Icom IC-7300MK2</strong>. Sin menús ocultos: todo el control de RF, DSP, telegrafía CW, memorias y cascada en una única ventana fluida.
    </p>

    <!-- Interactive Tabs -->
    <div class="shot-tabs" role="tablist">
      <button type="button" class="shot-tab active" data-shot-idx="0">
        <span class="shot-tab-num">01</span>
        <div class="shot-tab-text">
          <strong data-i18n="shot1_tab_t">RX / TX, DSP y Twin PBT (15m)</strong>
          <span data-i18n="shot1_tab_s">21.224.000 MHz · Cascada + Niveles RF/AF</span>
        </div>
      </button>

      <button type="button" class="shot-tab" data-shot-idx="1">
        <span class="shot-tab-num">02</span>
        <div class="shot-tab-text">
          <strong data-i18n="shot2_tab_t">Manipulador CW y Macros de Voz (40m)</strong>
          <span data-i18n="shot2_tab_s">7.099.000 MHz · Keyer CW M1–M8 y Voz T1–T8</span>
        </div>
      </button>

      <button type="button" class="shot-tab" data-shot-idx="2">
        <span class="shot-tab-num">03</span>
        <div class="shot-tab-text">
          <strong data-i18n="shot3_tab_t">Memorias, Escaneo y Macros P1–P12 (20m FT8)</strong>
          <span data-i18n="shot3_tab_s">14.074.000 MHz · Señal S9+11dB a 30.0 fps</span>
        </div>
      </button>
    </div>

    <!-- Active Screenshot Stage -->
    <div class="shot-stage">
      <!-- Slide 1 -->
      <article class="shot-slide active" data-shot-slide="0">
        <div class="shot-img-container" data-lightbox-src="/imagenes/screenshots/Screenshot_1.jpg">
          <img
            src="/imagenes/screenshots/Screenshot_1.jpg"
            alt="NetShack Control en 15m (21.224.000 MHz) mostrando la pestaña RX/TX, DSP y Twin PBT"
            loading="lazy"
          />
          <button type="button" class="zoom-badge" data-i18n="shots_zoom">🔍 Ampliar captura a pantalla completa</button>
        </div>
        <div class="shot-caption-bar">
          <div>
            <h3 data-i18n="shot1_title">Control completo de RF, Medidores y DSP Twin PBT</h3>
            <p data-i18n="shot1_desc">
              Doble VFO con sintonía por rueda de ratón, matriz directa de bandas (160m a 4m), telemetría completa en tiempo real (S-meter, Potencia Po, ROE/SWR, ALC, COMP, tensión Vd 12,8V) y ajuste directo de ganancia AF/RF, SQL, NB, NR, Notch (AN/MN) y Twin PBT.
            </p>
          </div>
          <div class="shot-tags">
            <span>IC-7300MK2</span>
            <span>21.224 MHz USB</span>
            <span>Twin PBT</span>
            <span>IARU R1</span>
          </div>
        </div>
      </article>

      <!-- Slide 2 -->
      <article class="shot-slide" data-shot-slide="1">
        <div class="shot-img-container" data-lightbox-src="/imagenes/screenshots/Screenshot_2.png">
          <img
            src="/imagenes/screenshots/Screenshot_2.png"
            alt="NetShack Control en 40m (7.099.000 MHz) mostrando la pestaña CW/Voz con Keyer y Macros"
            loading="lazy"
          />
          <button type="button" class="zoom-badge" data-i18n="shots_zoom">🔍 Ampliar captura a pantalla completa</button>
        </div>
        <div class="shot-caption-bar">
          <div>
            <h3 data-i18n="shot2_title">Manipulador CW (Keyer), Macros M1–M8 y Grabador de Voz T1–T8</h3>
            <p data-i18n="shot2_desc">
              Operación en telegrafía y fonía lista para concursos y DX: control de Break-in (OFF / SEMI / FULL), velocidad en PPM, tono lateral en Hz, envío directo de CW desde el teclado, 8 memorias CW editables (CQ, DE, 5NN, TU 73...) y 8 memorias de voz TX del transceptor.
            </p>
          </div>
          <div class="shot-tags">
            <span>40m · 7.099 MHz</span>
            <span>CW Keyer 20 PPM</span>
            <span>Macros M1–M8</span>
            <span>Voice TX T1–T8</span>
          </div>
        </div>
      </article>

      <!-- Slide 3 -->
      <article class="shot-slide" data-shot-slide="2">
        <div class="shot-img-container" data-lightbox-src="/imagenes/screenshots/Screenshot_3.png">
          <img
            src="/imagenes/screenshots/Screenshot_3.png"
            alt="NetShack Control en 20m FT8 (14.074.000 MHz) mostrando Memorias, Escaneo y Macros programables P1-P12"
            loading="lazy"
          />
          <button type="button" class="zoom-badge" data-i18n="shots_zoom">🔍 Ampliar captura a pantalla completa</button>
        </div>
        <div class="shot-caption-bar">
          <div>
            <h3 data-i18n="shot3_title">Bancos de Memoria, Escáner y 12 Macros Programables (P1–P12)</h3>
            <p data-i18n="shot3_desc">
              Cascada de alta densidad a 30.0 fps monitorizando 20m FT8 (14.074 MHz con lecturas S9+11dB). Incluye transferencia VFO ↔ Memoria, escaneo programado (PROG, FINO, ΔF) y 12 botones de automatización rápida para saltar a frecuencias FT8/CW/SSB o activar filtros con un clic.
            </p>
          </div>
          <div class="shot-tags">
            <span>20m FT8 · 14.074 MHz</span>
            <span>30.0 FPS</span>
            <span>S9+11dB</span>
            <span>Macros P1–P12</span>
          </div>
        </div>
      </article>
    </div>

    <!-- Thumbnail Grid below for quick comparison -->
    <div class="shot-thumbs-grid">
      <div class="thumb-card active" data-shot-thumb="0">
        <img src="/imagenes/screenshots/Screenshot_1.jpg" alt="Miniatura RX/TX y DSP" loading="lazy" />
        <span data-i18n="shot1_tab_t">RX / TX, DSP y Twin PBT (15m)</span>
      </div>
      <div class="thumb-card" data-shot-thumb="1">
        <img src="/imagenes/screenshots/Screenshot_2.png" alt="Miniatura CW y Voz" loading="lazy" />
        <span data-i18n="shot2_tab_t">Manipulador CW y Macros de Voz (40m)</span>
      </div>
      <div class="thumb-card" data-shot-thumb="2">
        <img src="/imagenes/screenshots/Screenshot_3.png" alt="Miniatura Memorias y Escaneo" loading="lazy" />
        <span data-i18n="shot3_tab_t">Memorias, Escaneo y Macros P1–P12 (20m FT8)</span>
      </div>
    </div>
  </div>

  <!-- Fullscreen Lightbox Modal -->
  <div id="shotLightbox" class="lightbox-modal" aria-hidden="true">
    <button type="button" id="lightboxClose" class="lightbox-close" aria-label="Cerrar">✕</button>
    <img id="lightboxImg" src="" alt="Captura ampliada de NetShack Control" />
  </div>
</section>

<script is:inline>
  window.registerTranslations({
    es: {
      shots_eyebrow: "INTERFAZ REAL DE ESCRITORIO",
      shots_title: "Diseñado para operar rápido en el shack y en remoto",
      shots_lead: "Capturas reales de NetShack Control conectado por red a un Icom IC-7300MK2. Sin menús ocultos: todo el control de RF, DSP, telegrafía CW, memorias y cascada en una única ventana fluida.",
      shot1_tab_t: "RX / TX, DSP y Twin PBT (15m)",
      shot1_tab_s: "21.224.000 MHz · Cascada + Niveles RF/AF",
      shot2_tab_t: "Manipulador CW y Macros de Voz (40m)",
      shot2_tab_s: "7.099.000 MHz · Keyer CW M1–M8 y Voz T1–T8",
      shot3_tab_t: "Memorias, Escaneo y Macros P1–P12 (20m FT8)",
      shot3_tab_s: "14.074.000 MHz · Señal S9+11dB a 30.0 fps",
      shots_zoom: "🔍 Ampliar captura a pantalla completa",
      shot1_title: "Control completo de RF, Medidores y DSP Twin PBT",
      shot1_desc: "Doble VFO con sintonía por rueda de ratón, matriz directa de bandas (160m a 4m), telemetría completa en tiempo real (S-meter, Potencia Po, ROE/SWR, ALC, COMP, tensión Vd 12,8V) y ajuste directo de ganancia AF/RF, SQL, NB, NR, Notch (AN/MN) y Twin PBT.",
      shot2_title: "Manipulador CW (Keyer), Macros M1–M8 y Grabador de Voz T1–T8",
      shot2_desc: "Operación en telegrafía y fonía lista para concursos y DX: control de Break-in (OFF / SEMI / FULL), velocidad en PPM, tono lateral en Hz, envío directo de CW desde el teclado, 8 memorias CW editables (CQ, DE, 5NN, TU 73...) y 8 memorias de voz TX del transceptor.",
      shot3_title: "Bancos de Memoria, Escáner y 12 Macros Programables (P1–P12)",
      shot3_desc: "Cascada de alta densidad a 30.0 fps monitorizando 20m FT8 (14.074 MHz con lecturas S9+11dB). Incluye transferencia VFO ↔ Memoria, escaneo programado (PROG, FINO, ΔF) y 12 botones de automatización rápida para saltar a frecuencias FT8/CW/SSB o activar filtros con un clic."
    },
    en: {
      shots_eyebrow: "REAL DESKTOP INTERFACE",
      shots_title: "Built for fast operation in the shack and remotely",
      shots_lead: "Real screenshots of NetShack Control connected over LAN to an Icom IC-7300MK2. No buried menus: full RF control, DSP, CW keyer, memories, and 30 fps waterfall in a single responsive window.",
      shot1_tab_t: "RX / TX, DSP & Twin PBT (15m)",
      shot1_tab_s: "21.224.000 MHz · Waterfall + RF/AF Levels",
      shot2_tab_t: "CW Keyer & Voice Macros (40m)",
      shot2_tab_s: "7.099.000 MHz · CW Keyer M1–M8 & Voice T1–T8",
      shot3_tab_t: "Memories, Scan & P1–P12 Macros (20m FT8)",
      shot3_tab_s: "14.074.000 MHz · S9+11dB signal at 30.0 fps",
      shots_zoom: "🔍 Click to view fullscreen screenshot",
      shot1_title: "Complete RF Control, Telemetry Meters & Twin PBT DSP",
      shot1_desc: "Dual VFO with mouse-wheel tuning, instant band matrix (160m to 4m), real-time telemetry meters (S-meter, Po power, SWR, ALC, COMP, Vd 12.8V supply), and direct sliders for AF/RF gain, SQL, NB, NR, Notch (AN/MN), and Twin PBT.",
      shot2_title: "CW Keyer, M1–M8 Macros & T1–T8 Voice Keyer",
      shot2_desc: "Contest and DX-ready CW & phone operation: Break-in control (OFF / SEMI / FULL), WPM speed, sidetone pitch, keyboard CW sending, 8 editable CW macros (CQ, DE, 5NN, TU 73...), and 8 transceiver TX voice memories.",
      shot3_title: "Memory Banks, Scanner & 12 Programmable Macros (P1–P12)",
      shot3_desc: "High-density 30.0 fps waterfall monitoring 20m FT8 (14.074 MHz with S9+11dB signals). Features VFO ↔ Memory transfer, programmed scanning (PROG, FINE, ΔF), and 12 one-click automation buttons for FT8/CW/SSB frequencies and DSP presets."
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('[data-shot-idx]');
    const slides = document.querySelectorAll('[data-shot-slide]');
    const thumbs = document.querySelectorAll('[data-shot-thumb]');

    function selectShot(idx) {
      tabs.forEach((t, i) => t.classList.toggle('active', i === idx));
      slides.forEach((s, i) => s.classList.toggle('active', i === idx));
      thumbs.forEach((th, i) => th.classList.toggle('active', i === idx));
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        selectShot(parseInt(tab.getAttribute('data-shot-idx') || '0', 10));
      });
    });

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        selectShot(parseInt(thumb.getAttribute('data-shot-thumb') || '0', 10));
      });
    });

    // Lightbox
    const lightbox = document.getElementById('shotLightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxClose = document.getElementById('lightboxClose');

    document.querySelectorAll('[data-lightbox-src]').forEach((el) => {
      el.addEventListener('click', () => {
        const src = el.getAttribute('data-lightbox-src');
        if (src && lightbox && lightboxImg) {
          lightboxImg.setAttribute('src', src);
          lightbox.classList.add('open');
        }
      });
    });

    const closeBox = () => lightbox?.classList.remove('open');
    lightboxClose?.addEventListener('click', closeBox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeBox();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeBox();
    });
  });
</script>

<style>
  .shot-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 22px;
  }

  .shot-tab {
    display: flex;
    align-items: center;
    gap: 14px;
    text-align: left;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shot-tab:hover {
    border-color: rgba(56, 189, 248, 0.45);
    background: var(--surface-alt);
  }

  .shot-tab.active {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.16), rgba(17, 26, 46, 0.95));
    border-color: var(--accent);
    box-shadow: 0 10px 28px -12px rgba(56, 189, 248, 0.45);
  }

  .shot-tab-num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent);
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 8px 10px;
    border-radius: 8px;
  }

  .shot-tab-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .shot-tab-text strong {
    font-size: 0.96rem;
    color: var(--text-bright);
  }

  .shot-tab-text span {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
  }

  .shot-stage {
    background: #0a101d;
    border: 1px solid var(--border-bright);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 22px 50px -15px rgba(0, 0, 0, 0.75);
  }

  .shot-slide {
    display: none;
  }

  .shot-slide.active {
    display: block;
  }

  .shot-img-container {
    position: relative;
    cursor: zoom-in;
    line-height: 0;
    overflow: hidden;
  }

  .shot-img-container img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .shot-img-container:hover img {
    transform: scale(1.01);
  }

  .zoom-badge {
    position: absolute;
    right: 16px;
    bottom: 16px;
    background: rgba(7, 11, 20, 0.88);
    color: var(--text-bright);
    border: 1px solid var(--border-bright);
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .shot-caption-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 24px 28px;
    background: var(--surface);
    border-top: 1px solid var(--border);
  }

  .shot-caption-bar h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text-bright);
    margin-bottom: 6px;
  }

  .shot-caption-bar p {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 780px;
  }

  .shot-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .shot-tags span {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 5px 11px;
    border-radius: 6px;
    background: #0b1120;
    border: 1px solid var(--border);
    color: var(--accent);
  }

  .shot-thumbs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 18px;
  }

  .thumb-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    opacity: 0.72;
  }

  .thumb-card:hover,
  .thumb-card.active {
    opacity: 1;
    border-color: var(--accent);
  }

  .thumb-card img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
    margin-bottom: 8px;
  }

  .thumb-card span {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    text-align: center;
  }

  /* Lightbox */
  .lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(4, 7, 14, 0.92);
    backdrop-filter: blur(10px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 28px;
  }

  .lightbox-modal.open {
    display: flex;
  }

  .lightbox-modal img {
    max-width: 96vw;
    max-height: 90vh;
    border-radius: 12px;
    border: 1px solid var(--border-bright);
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.9);
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 26px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-bright);
    background: var(--surface);
    color: #fff;
    font-size: 1.2rem;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .shot-tabs,
    .shot-thumbs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
