<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-bright);
    box-shadow: 0 18px 38px -15px rgba(56, 189, 248, 0.22);
  }

  .feature-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 16px;
  }

  .feature-card h3 {
    font-family: var(--font-display);
    font-size: 1.18rem;
    color: var(--text-bright);
    margin-bottom: 10px;
  }

  .feature-card p {
    color: var(--muted);
    font-size: 0.94rem;
    flex: 1;
    margin-bottom: 18px;
  }

  .feature-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid rgba(35, 50, 82, 0.6);
  }

  .feature-meta span {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent);
    background: rgba(56, 189, 248, 0.08);
    padding: 3px 9px;
    border-radius: 6px;
  }

  /* Architecture Splits */
  .showcase-split {
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    gap: 36px;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 28px;
    margin-bottom: 28px;
  }

  .showcase-split.reverse {
    grid-template-columns: 1fr 1.08fr;
  }

  .showcase-split.reverse .split-media {
    order: 2;
  }

  .split-media {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border-bright);
    line-height: 0;
  }

  .split-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .media-badge {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: rgba(7, 11, 20, 0.88);
    backdrop-filter: blur(8px);
    color: var(--accent);
    border: 1px solid var(--border-bright);
    border-radius: 8px;
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.3;
  }

  .split-content h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text-bright);
    margin-bottom: 12px;
  }

  .split-content > p {
    color: var(--muted);
    font-size: 0.98rem;
    margin-bottom: 20px;
  }

  .arch-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .arch-list li {
    position: relative;
    padding-left: 22px;
    font-size: 0.93rem;
    color: var(--muted);
  }

  .arch-list li::before {
    content: "▸";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .arch-list li strong {
    color: var(--text-bright);
    margin-right: 4px;
  }

  @media (max-width: 980px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
    .showcase-split,
    .showcase-split.reverse {
      grid-template-columns: 1fr;
    }
    .showcase-split.reverse .split-media {
      order: 0;
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
