<style>
  .manual-page {
    padding: 48px 0 80px;
  }

  .manual-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 36px;
    align-items: start;
  }

  .manual-sidebar {
    position: sticky;
    top: 94px;
  }

  .sidebar-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px;
  }

  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }

  .sidebar-nav a {
    color: var(--muted);
    font-size: 0.9rem;
    padding: 7px 10px;
    border-radius: 8px;
    transition: all 0.15s ease;
  }

  .sidebar-nav a:hover {
    background: rgba(56, 189, 248, 0.12);
    color: var(--text-bright);
  }

  .manual-hero-banner {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.14), rgba(17, 26, 46, 0.95));
    border: 1px solid var(--border-bright);
    border-radius: 18px;
    padding: 32px;
    margin-bottom: 28px;
  }

  .manual-hero-banner h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    color: var(--text-bright);
    margin-bottom: 10px;
  }

  .manual-hero-banner p {
    color: var(--muted);
    font-size: 1.04rem;
  }

  .doc-chapter {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 30px;
    margin-bottom: 24px;
    scroll-margin-top: 90px;
  }

  .doc-chapter h2 {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--text-bright);
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(35, 50, 82, 0.65);
  }

  .doc-chapter p {
    color: var(--muted);
    margin-bottom: 16px;
