---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'NetShack Control — Control Remoto IP y CAT/CI-V para Transceptores Icom',
  description = 'Suite open-source en Rust para Windows, macOS y Linux. Alternativa libre a Icom RS-BA1 V2 con espectro y cascada a 30 fps, audio LAN/Opus, CW/Voz, controladores RC-28/Shuttle/MIDI, rigctld y servidor para Raspberry Pi.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="bg-grid" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container nav-bar">
        <a href="/" class="brand">
          <span class="brand-icon">
            <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="1.5" y="1.5" width="33" height="33" rx="8" fill="#0d1629" stroke="#38bdf8" stroke-opacity="0.5" stroke-width="1.5"/>
              <circle cx="18" cy="19.5" r="8" stroke="#38bdf8" stroke-width="2"/>
              <circle cx="18" cy="19.5" r="2.5" fill="#22c55e"/>
              <path d="M9 11.5C11.5 8.8 14.6 7.5 18 7.5C21.4 7.5 24.5 8.8 27 11.5" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="18" y1="19.5" x2="23" y2="14.5" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="brand-text">NetShack <em>Control</em></span>
          <span class="status-pill">
            <span class="status-dot"></span>
            <span data-i18n="nav_status">IC-7300MK2 · LAN</span>
          </span>
        </a>

        <nav class="nav-links">
          <a href="/#screenshots" data-i18n="nav_screenshots">Capturas</a>
          <a href="/#features" data-i18n="nav_features">Características</a>
          <a href="/#architecture" data-i18n="nav_arch">Arquitectura</a>
          <a href="/#radios" data-i18n="nav_radios">Equipos (17)</a>
          <a href="/#cli" data-i18n="nav_cli">CLI &amp; Sim</a>
          <a href="/#downloads" data-i18n="nav_downloads">Descargas</a>
          <a href="/manual" class="nav-manual-link" data-i18n="nav_manual">Manual</a>
        </nav>

        <div class="nav-actions">
          <button id="langToggle" class="lang-btn" type="button" aria-label="Cambiar idioma / Switch language">
            <span class="lang-globe">🌐</span>
            <span id="langLabel">EN</span>
          </button>
          <a href="/#downloads" class="btn btn-sm btn-primary hide-mobile" data-i18n="nav_cta">
            Descargar
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand-col">
          <div class="brand">
            <span class="brand-text">NetShack <em>Control</em></span>
          </div>
          <p class="footer-desc" data-i18n="footer_desc">
            Control remoto por IP y CAT/CI-V para transceptores Icom, escrito en Rust para Windows, macOS y Linux. Alternativa libre a Icom RS-BA1 Version 2.
          </p>
          <p class="footer-trademark" data-i18n="footer_trademark">
            NetShack Control no está afiliado a Icom Inc. «Icom», «RS-BA1» y «CI-V» son marcas registradas de Icom Inc.
          </p>
        </div>

        <div class="footer-links-col">
          <h4 data-i18n="footer_col_nav">Navegación</h4>
          <ul>
            <li><a href="/#screenshots" data-i18n="nav_screenshots">Capturas</a></li>
            <li><a href="/#features" data-i18n="nav_features">Características</a></li>
            <li><a href="/#radios" data-i18n="nav_radios">Equipos (17)</a></li>
            <li><a href="/#downloads" data-i18n="nav_downloads">Descargas</a></li>
          </ul>
        </div>

        <div class="footer-links-col">
          <h4 data-i18n="footer_col_docs">Documentación</h4>
          <ul>
            <li><a href="/manual#intro" data-i18n="man_nav_intro">Introducción</a></li>
            <li><a href="/manual#connecting" data-i18n="man_nav_conn">Conexión LAN y USB</a></li>
            <li><a href="/manual#controllers" data-i18n="man_nav_ctrl">Controladores RC-28 y MIDI</a></li>
            <li><a href="/manual#integrations" data-i18n="man_nav_int">WSJT-X, Hamlib y FLRig</a></li>
            <li><a href="/manual#server" data-i18n="man_nav_srv">Servidor Raspberry Pi</a></li>
          </ul>
        </div>
      </div>

      <div class="container footer-bottom">
        <span data-i18n="footer_copy">NetShack Control · Software libre bajo licencia GPL-3.0-or-later · 73!</span>
        <span class="footer-badges">
          <span class="mini-tag">Rust 1.85+</span>
          <span class="mini-tag">GPL-3.0</span>
          <span class="mini-tag">IARU R1 / R2 / R3</span>
        </span>
      </div>
    </footer>

    <script is:inline>
      window.NETSHACK_I18N = {
        es: {
          nav_status: "IC-7300MK2 · LAN",
          nav_screenshots: "Capturas",
          nav_features: "Características",
          nav_arch: "Arquitectura",
          nav_radios: "Equipos (17)",
          nav_cli: "CLI & Sim",
          nav_downloads: "Descargas",
          nav_manual: "Manual",
          nav_cta: "Descargar",
          footer_desc: "Control remoto por IP y CAT/CI-V para transceptores Icom, escrito en Rust para Windows, macOS y Linux. Alternativa libre a Icom RS-BA1 Version 2.",
          footer_trademark: "NetShack Control no está afiliado a Icom Inc. «Icom», «RS-BA1» y «CI-V» son marcas registradas de Icom Inc.",
          footer_col_nav: "Navegación",
          footer_col_docs: "Documentación",
          footer_copy: "NetShack Control · Software libre bajo licencia GPL-3.0-or-later · 73!",
          man_nav_intro: "Introducción",
          man_nav_conn: "Conexión LAN y USB",
          man_nav_ctrl: "Controladores RC-28 y MIDI",
          man_nav_int: "WSJT-X, Hamlib y FLRig",
          man_nav_srv: "Servidor Raspberry Pi"
        },
        en: {
          nav_status: "IC-7300MK2 · LAN",
          nav_screenshots: "Screenshots",
          nav_features: "Features",
          nav_arch: "Architecture",
          nav_radios: "Radios (17)",
          nav_cli: "CLI & Sim",
          nav_downloads: "Downloads",
          nav_manual: "Manual",
          nav_cta: "Download",
          footer_desc: "IP and CAT/CI-V remote control for Icom transceivers, written in Rust for Windows, macOS, and Linux. Free open-source alternative to Icom RS-BA1 Version 2.",
          footer_trademark: "NetShack Control is not affiliated with Icom Inc. 'Icom', 'RS-BA1', and 'CI-V' are registered trademarks of Icom Inc.",
          footer_col_nav: "Navigation",
          footer_col_docs: "Documentation",
          footer_copy: "NetShack Control · Free software under GPL-3.0-or-later license · 73!",
          man_nav_intro: "Introduction",
          man_nav_conn: "LAN & USB Connection",
          man_nav_ctrl: "RC-28 & MIDI Controllers",
          man_nav_int: "WSJT-X, Hamlib & FLRig",
          man_nav_srv: "Raspberry Pi Server"
        }
      };

      window.registerTranslations = function(extraDict) {
        if (extraDict.es) Object.assign(window.NETSHACK_I18N.es, extraDict.es);
        if (extraDict.en) Object.assign(window.NETSHACK_I18N.en, extraDict.en);
        if (window.applyNetShackLang) {
          window.applyNetShackLang(document.documentElement.lang || 'es');
        }
      };

      window.applyNetShackLang = function(lang) {
        const target = lang === 'en' ? 'en' : 'es';
        const dict = window.NETSHACK_I18N[target];
        document.documentElement.lang = target;
        try {
          localStorage.setItem('netshack_lang', target);
        } catch (e) {}
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (dict && dict[key]) {
            el.textContent = dict[key];
          }
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (dict && dict[key]) {
            el.setAttribute('placeholder', dict[key]);
          }
        });
        const label = document.getElementById('langLabel');
        if (label) label.textContent = target === 'es' ? 'EN' : 'ES';
        window.dispatchEvent(new CustomEvent('netshack:lang', { detail: { lang: target } }));
      };

      document.addEventListener('DOMContentLoaded', () => {
        let initial = 'es';
        try {
          const saved = localStorage.getItem('netshack_lang');
          if (saved === 'en' || saved === 'es') {
            initial = saved;
          }
        } catch (e) {}
        window.applyNetShackLang(initial);

        const btn = document.getElementById('langToggle');
        if (btn) {
          btn.addEventListener('click', () => {
            const next = document.documentElement.lang === 'es' ? 'en' : 'es';
            window.applyNetShackLang(next);
          });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #070b14;
    --bg-elevated: #0b1120;
    --surface: #111a2e;
    --surface-alt: #17233d;
    --surface-glass: rgba(17, 26, 46, 0.78);
    --border: #233252;
    --border-bright: rgba(56, 189, 248, 0.42);
    --text: #e2e8f0;
    --text-bright: #ffffff;
    --muted: #94a3b8;
    --accent: #38bdf8;
    --accent-glow: rgba(56, 189, 248, 0.25);
    --green: #22c55e;
    --amber: #f59e0b;
    --red: #ef4444;
    --purple: #a855f7;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-display: 'Space Grotesk', 'Inter', sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
    color: var(--text);
  }

  body {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
  }

  .bg-grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background-image:
      radial-gradient(circle at 18% 10%, rgba(56, 189, 248, 0.11), transparent 40%),
      radial-gradient(circle at 85% 22%, rgba(34, 197, 94, 0.08), transparent 38%),
      linear-gradient(to right, rgba(35, 50, 82, 0.18) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(35, 50, 82, 0.18) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 48px 48px, 48px 48px;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 11, 20, 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-bright);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.18rem;
    letter-spacing: -0.01em;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-icon svg {
    width: 34px;
    height: 34px;
    display: block;
  }

  .brand-text em {
    font-style: normal;
    color: var(--accent);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: #4ade80;
    margin-left: 4px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.85); }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .nav-links a {
    color: var(--muted);
  }

  .nav-links a:hover {
    color: var(--text-bright);
  }

  .nav-manual-link {
    padding: 5px 12px;
    border-radius: 8px;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.28);
    color: var(--accent) !important;
    font-weight: 600;
  }

  .nav-manual-link:hover {
    background: rgba(56, 189, 248, 0.18);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 7px 12px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.82rem;
    transition: all 0.18s ease;
  }

  .lang-btn:hover {
    border-color: var(--accent);
    color: var(--text-bright);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.96rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .btn-sm {
    padding: 8px 15px;
    font-size: 0.86rem;
    border-radius: 8px;
  }

  .btn-primary {
    background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
    color: #04101f;
    box-shadow: 0 8px 24px -6px rgba(56, 189, 248, 0.45);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 28px -6px rgba(56, 189, 248, 0.65);
    color: #04101f;
  }

  .btn-secondary {
    background: var(--surface);
    color: var(--text-bright);
    border-color: var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    background: var(--surface-alt);
  }

  /* Sections */
  section {
    padding: 84px 0;
    border-top: 1px solid rgba(35, 50, 82, 0.65);
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.26);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3vw, 2.55rem);
    line-height: 1.18;
    color: var(--text-bright);
    margin-bottom: 12px;
  }

  .section-lead {
    color: var(--muted);
    font-size: 1.08rem;
    max-width: 760px;
    margin-bottom: 36px;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--border);
    background: #050811;
    padding: 56px 0 32px;
    margin-top: 40px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 36px;
    border-bottom: 1px solid rgba(35, 50, 82, 0.5);
  }

  .footer-desc {
    color: var(--muted);
    font-size: 0.94rem;
    margin-top: 12px;
    max-width: 480px;
  }

  .footer-trademark {
    color: #64748b;
    font-size: 0.82rem;
    margin-top: 12px;
  }

  .footer-links-col h4 {
    color: var(--text-bright);
    font-size: 0.95rem;
    margin-bottom: 14px;
  }

  .footer-links-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links-col a {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-links-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .footer-badges {
    display: flex;
    gap: 8px;
  }

  .mini-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .nav-links {
      display: none;
    }
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 600px) {
    .status-pill,
    .hide-mobile {
      display: none;
    }
    section {
      padding: 60px 0;
    }
  }
</style>
